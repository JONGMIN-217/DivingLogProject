APP_ENV=development
# 운영 환경에서는 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 등으로 생성한
# 32자 이상의 고정 키를 배포 플랫폼의 비밀 환경변수로 설정하세요.
SECRET_KEY=replace-with-a-long-random-secret

# 로컬 개발
DATABASE_URL=sqlite:///./divinglog.db
# 운영 PostgreSQL 예시
# DATABASE_URL=postgresql+psycopg://divinglog:password@db:5432/divinglog

# 운영에서는 재배포 후에도 유지되는 영구 볼륨 경로를 사용하세요.
UPLOAD_DIR=uploads
STATIC_DIR=static
TEMPLATES_DIR=templates
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=1209600
FORCE_HTTPS=false
ALLOW_REGISTRATION=true
# 빈 운영 DB의 첫 관리자 생성에만 사용하고 생성 후 제거하세요.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
RUN_STARTUP_MAINTENANCE=true
MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_IMPORT_FILE_SIZE_MB=200
MAX_BACKUP_UPLOAD_SIZE_MB=500
